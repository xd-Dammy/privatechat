rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    // An admin is a document at admins/{uid}, added by hand in the Firebase Console.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Nobody can create or change admins from the app. A person may only read their own entry.
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Private chat ids are "uidA_uidB" (sorted), so the id itself says who
    // the two participants are.
    function inChat(chatId) { return signedIn() && request.auth.uid in chatId.split('_'); }

    // Call doc ids are "call_uidA_uidB" (sorted), same idea.
    function inCallId(callId) { return signedIn() && request.auth.uid in callId.split('_'); }

    function isGroupMember(groupId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // ---------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Needed for find-by-number and Discover. NOTE: the user doc includes
      // the email address, so every signed-in user can read it. See notes.
      allow read: if signedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();

      // users/{me}/contacts/{other} is MY copy of the relationship. Its
      // "uid" field is the other person. The app also writes to the other
      // person's copy (users/{other}/contacts/{me}, where uid == me), so
      // writes are allowed to the list owner, or to the person the entry
      // describes, but only for limited fields.
      match /contacts/{contactId} {
        // Admins may also read/write contact entries: the in-app Broadcast creates
        // an accepted link between "PrivateChat Support" and every user.
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin();

        // I send a request: my own entry, pending_sent.
        allow create: if isOwner(userId)
                      && request.resource.data.uid == contactId
                      && request.resource.data.status == 'pending_sent';
        // ...and the entry in the other person's list, pending_received.
        allow create: if signedIn()
                      && request.auth.uid == contactId
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.status == 'pending_received';

        // The list owner can update their own entry but can't repoint it.
        allow update: if isOwner(userId)
                      && request.resource.data.uid == resource.data.uid;
        // The person the entry describes can refresh their name/avatar and
        // last-message info. They can only change status when accepting a
        // request they received (the entry in the requester's list is
        // 'pending_sent'). This stops someone marking themselves as
        // accepted in somebody else's list.
        allow update: if signedIn()
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['displayName', 'avatar', 'lastMessageText', 'lastMessageAt', 'unreadCount', 'status'])
                      && (request.resource.data.status == resource.data.status
                          || (resource.data.status == 'pending_sent' && request.resource.data.status == 'accepted'));

        // Owner removes a contact, or the other person declines/removes
        // their side of it.
        allow delete: if isOwner(userId) || (signedIn() && resource.data.uid == request.auth.uid);
      }

      match /reminders/{reminderId} { allow read, create, update, delete: if isOwner(userId); }
      match /callHistory/{callId} { allow read, create, update, delete: if isOwner(userId); }
      match /fcmTokens/{tokenId} { allow read, create, update, delete: if isOwner(userId); }
    }

    // Lets the app find "my entry in everyone's contact list" (used to push
    // name/avatar changes). Only entries that describe the caller.
    // Needs the collection-group index in firestore.indexes.json.
    match /{path=**}/contacts/{contactId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Private chats
    // ---------------------------------------------------------------
    match /chats/{chatId}/messages/{messageId} {
      allow read: if inChat(chatId);

      // recipientId must be the other person in this chat, otherwise a
      // sender could aim push notifications at anyone.
      allow create: if inChat(chatId)
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.recipientId in chatId.split('_')
                    && request.resource.data.recipientId != request.auth.uid;

      // Sender can edit their text. The other person can only mark it read.
      allow update: if inChat(chatId) && (
                      (resource.data.senderId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited']))
                      ||
                      (resource.data.senderId != request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']))
                    );

      allow delete: if inChat(chatId) && resource.data.senderId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Groups
    // ---------------------------------------------------------------
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.auth.uid in request.resource.data.admins
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        // Group admins: rename, add/remove members, promote.
        (request.auth.uid in resource.data.admins)
        ||
        // Any member: unread counters, last-message preview, and their own
        // memberInfo entry (name/avatar).
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadCounts', 'lastMessageText', 'lastMessageAt', 'memberInfo'])
          && (!('memberInfo' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys()
                   .hasOnly([request.auth.uid])))
        ||
        // Any member: leave the group (remove only themselves).
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.hasOnly(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.admins.hasOnly(resource.data.admins)
          && !(request.auth.uid in request.resource.data.admins))
      );

      allow delete: if signedIn() && request.auth.uid in resource.data.admins;

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn() && resource.data.senderId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited']);
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------
    // Statuses
    // ---------------------------------------------------------------
    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      // request.resource is null on delete, so this must check resource.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }


    // ---------------------------------------------------------------
    // Group calls: only members of the group can see or join its call.
    // groupCalls/{groupId} (same id as the group), with signalling messages below it.
    // ---------------------------------------------------------------
    function isGroupMember(gid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }

    match /groupCalls/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if isGroupMember(gid)
                    && request.resource.data.status == 'active'
                    && request.resource.data.participants == [request.auth.uid];
      allow update: if (signedIn() && request.auth.uid in resource.data.members
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'status', 'updatedAt']))
                    // Starting a NEW call in the same group (overwrites the finished/abandoned one).
                    || (isGroupMember(gid)
                        && request.resource.data.status == 'active'
                        && request.resource.data.participants == [request.auth.uid]
                        && (resource.data.status != 'active'
                            || resource.data.participants.size() == 0
                            || resource.data.updatedAt < request.time - duration.value(2, 'm')));

      match /signals/{sigId} {
        allow create: if isGroupMember(gid) && request.resource.data.from == request.auth.uid;
        allow read, delete: if signedIn() && resource.data.to == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------
    // Feed (paid). Access = subscriptions/{uid}.until is in the future (or admin).
    // Admins grant it by hand or from the Admin tab; a payment webhook can write it later.
    // ---------------------------------------------------------------
    function isSubscribed() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid))
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.until > request.time);
    }

    match /subscriptions/{subId} {
      allow read: if isOwner(subId) || isAdmin();
      allow write: if isAdmin();
    }

    // Payment claims: the app records "I paid, reference X" after Paystack succeeds; an admin
    // checks the reference in the Paystack dashboard and approves. The doc id IS the reference,
    // so the same reference can't be claimed twice.
    match /paymentClaims/{ref} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.reference == ref;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // The only change a non-author may make to a post is adding/removing their own uid in likedBy.
    function onlyMyLikeChanged() {
      let before = resource.data.likedBy.toSet();
      let after = request.resource.data.likedBy.toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && ((after.difference(before).hasOnly([request.auth.uid]) && before.difference(after).size() == 0)
            || (before.difference(after).hasOnly([request.auth.uid]) && after.difference(before).size() == 0));
    }

    match /posts/{postId} {
      allow read: if isSubscribed();
      allow create: if isSubscribed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.likedBy.size() == 0;
      allow update: if isSubscribed() && (
                      (resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.text.size() <= 2000)
                      || onlyMyLikeChanged());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------------
    // Feedback
    // ---------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Calls
    // ---------------------------------------------------------------
    match /calls/{callId} {
      allow read: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);

      // Only the caller creates a call, and the doc id must contain both
      // people (this is what the candidate rules below rely on).
      allow create: if signedIn()
                    && request.resource.data.callerId == request.auth.uid
                    && inCallId(callId)
                    && request.resource.data.calleeId in callId.split('_')
                    && request.resource.data.calleeId != request.auth.uid;

      allow update: if signedIn()
                    && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid)
                    && (
                      // normal updates: answer, decline, end
                      (request.resource.data.callerId == resource.data.callerId
                        && request.resource.data.calleeId == resource.data.calleeId)
                      ||
                      // Same two people calling again with the roles swapped.
                      // The doc id is the same for both directions, so the
                      // app overwrites the old doc with setDoc.
                      (request.resource.data.callerId == request.auth.uid
                        && request.resource.data.status == 'ringing'
                        && request.resource.data.calleeId in [resource.data.callerId, resource.data.calleeId]
                        && request.resource.data.calleeId != request.auth.uid)
                    );

      allow delete: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);

      // ICE candidates are written right as the call doc is created, so
      // these check the call id instead of reading the parent doc (a read
      // could race with the create and drop candidates).
      match /callerCandidates/{candidateId} { allow read, write: if inCallId(callId); }
      match /calleeCandidates/{candidateId} { allow read, write: if inCallId(callId); }
    }
  }
}
